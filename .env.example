# EmailService (services/email_service.py) 配置示例
# 注意：不要把真实密码/授权码提交到 Git。建议把真实值放在本机 `.env`（已在 `.gitignore` 中忽略）。

# 默认发送渠道：gmail / qq / 163 / custom
# - 未显式指定时，代码默认使用 gmail
EMAIL_PROVIDER=gmail

# ========= 渠道专属账号（推荐：可同时配置多个渠道）=========

# Gmail（推荐使用 App Password；通常需先开启两步验证后生成）
GMAIL_SMTP_USER=your_gmail@gmail.com
# App Password 可能显示为 "xxxx xxxx xxxx xxxx"；代码会自动去空格
GMAIL_SMTP_PASS=your_gmail_app_password
# 可选：不填则默认等于 GMAIL_SMTP_USER
GMAIL_SMTP_FROM=your_gmail@gmail.com

# QQ 邮箱（SMTP 授权码/客户端专用密码）
QQ_SMTP_USER=your_qq@qq.com
QQ_SMTP_PASS=your_qq_smtp_auth_code
# 可选：不填则默认等于 QQ_SMTP_USER
QQ_SMTP_FROM=your_qq@qq.com

# ========= 通用 SMTP（当 EMAIL_PROVIDER=custom 时使用）=========

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# 是否使用 SSL（465 常用 true；587 常用 false + STARTTLS）
SMTP_USE_SSL=false

# 通用认证（也可作为渠道专属变量缺失时的兜底）
SMTP_USER=
SMTP_PASS=
# 可选：不填则默认等于 SMTP_USER
SMTP_FROM=

# SMTP 连接超时（秒）
SMTP_TIMEOUT=15

# ========= 附件大小限制（字节）=========
# 默认：10MB = 10485760
EMAIL_ATTACH_MAX_BYTES=10485760
EMAIL_ATTACH_TOTAL_MAX_BYTES=10485760

